# BCBA Prep — environment
#
# Copy to .env.local for development. Set the real values in Vercel for
# preview and production. Never commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# SALES GATE
# ---------------------------------------------------------------------------
# The store is CLOSED unless this is exactly "true". Anything else — missing,
# empty, "1", "TRUE" — keeps it closed, which is deliberate: the gate fails
# safe. While closed, /api/checkout refuses to create a Stripe session and the
# storefront hides its prices and buy buttons.
#
# Do not set this to true until every item in LAUNCH_CHECKLIST.md is done.
# There are currently no study materials to deliver, so a completed payment
# would leave a real customer with a receipt and nothing else.
NEXT_PUBLIC_SALES_ENABLED=false

# ---------------------------------------------------------------------------
# STRIPE  (only needed once the gate above is opened)
# ---------------------------------------------------------------------------
# Real secret keys never go in this file or in git — set them in Vercel's
# environment variables, and in .env.local for development.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Set to "true" ONLY when real money is intended. Checkout refuses a LIVE
# Stripe key unless this is explicitly true, so opening the store for
# test-mode QA cannot accidentally arm real payments. Leave it unset for all
# test-mode work.
ALLOW_LIVE_PAYMENTS=false

# ---------------------------------------------------------------------------
# SUPABASE  (accounts, entitlements, protected content)
# ---------------------------------------------------------------------------
# Publishable browser values, not privileged secrets. Never put a Supabase
# secret/service-role key in a NEXT_PUBLIC_* variable.
#
# There is no hardcoded fallback for these. If either is missing, the features
# that need Supabase fail loudly in the logs rather than silently connecting to
# some other project.
#
# BOTH ARE REQUIRED FOR ACCOUNTS. Sign-up, sign-in and password reset all fail
# without them — and they fail before any request reaches Supabase, so the
# Supabase auth logs stay empty and the breakage looks like an email problem
# instead of a missing variable. GET /api/health says which one is absent.
#
# Changing a variable in Vercel does not alter deployments that already exist.
# Set it, then REDEPLOY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER-ONLY SECRET. Bypasses Row Level Security completely — a request made
# with this key can read and write every customer's rows.
#
# NOT prefixed NEXT_PUBLIC_, deliberately, so Next.js will never inline it
# into the browser bundle. Never rename it to add that prefix.
#
# Needed by exactly two things: the Stripe webhook (writing purchases and
# entitlements, where there is no user session to act as) and the signed-URL
# minting in /api/content/[id]. Without it, fulfilment and downloads fail.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# EMAIL  (contact form delivery, via Resend)
# ---------------------------------------------------------------------------
# All three are required together. Without them the contact form REFUSES
# submissions with an honest error rather than accepting a message that would
# go nowhere. CONTACT_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=re_...
CONTACT_INBOX_EMAIL=hello@yourdomain.com
CONTACT_FROM_EMAIL=website@yourdomain.com

# Optional. Where testimonial review alerts go; falls back to
# CONTACT_INBOX_EMAIL when unset. A missing value never fails a submission.
TESTIMONIAL_REVIEW_EMAIL=

# ---------------------------------------------------------------------------
# DEPLOYMENT SELF-CHECK
# ---------------------------------------------------------------------------
# Gates GET /api/health, which reports which required variables are absent in
# this environment and whether the server can reach Supabase. Send it as an
# x-health-token header.
#
# REQUIRED for the route to answer at all. It fails closed: with this unset
# there is no token that could match, so /api/health is 404 everywhere. An
# unset secret is never the same thing as an open door.
#
# Any long random string. Generate one with:  openssl rand -hex 32
HEALTH_CHECK_TOKEN=

# ---------------------------------------------------------------------------
# ANALYTICS  (optional)
# ---------------------------------------------------------------------------
# Microsoft Clarity project ID. Tracking is completely disabled when blank,
# which is the correct setting for local and preview environments.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ---------------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------------
# Absolute origin, used for Stripe Checkout return URLs and the password-reset
# redirect. Optional on Vercel, which supplies VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
