# BCBA Prep — environment
#
# Copy to .env.local for development. Set the real values in Vercel for
# preview and production. Never commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# SALES GATE
# ---------------------------------------------------------------------------
# The store is CLOSED unless this is exactly "true". Anything else — missing,
# empty, "1", "TRUE" — keeps it closed, which is deliberate: the gate fails
# safe. While closed, /api/checkout refuses to create a Stripe session and the
# storefront hides its prices and buy buttons.
#
# Do not set this to true until every item in LAUNCH_CHECKLIST.md is done.
# There are currently no study materials to deliver, so a completed payment
# would leave a real customer with a receipt and nothing else.
NEXT_PUBLIC_SALES_ENABLED=false

# ---------------------------------------------------------------------------
# STRIPE  (only needed once the gate above is opened)
# ---------------------------------------------------------------------------
# Real secret keys never go in this file or in git — set them in Vercel's
# environment variables, and in .env.local for development.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# SUPABASE  (member accounts and testimonials)
# ---------------------------------------------------------------------------
# Publishable browser values, not privileged secrets. Never put a Supabase
# secret/service-role key in a NEXT_PUBLIC_* variable.
#
# There is no hardcoded fallback for these. If either is missing, the features
# that need Supabase fail loudly in the logs rather than silently connecting to
# some other project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# EMAIL  (contact form delivery, via Resend)
# ---------------------------------------------------------------------------
# All three are required together. Without them the contact form REFUSES
# submissions with an honest error rather than accepting a message that would
# go nowhere. CONTACT_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=re_...
CONTACT_INBOX_EMAIL=hello@yourdomain.com
CONTACT_FROM_EMAIL=website@yourdomain.com

# Optional. Where testimonial review alerts go; falls back to
# CONTACT_INBOX_EMAIL when unset. A missing value never fails a submission.
TESTIMONIAL_REVIEW_EMAIL=

# ---------------------------------------------------------------------------
# ANALYTICS  (optional)
# ---------------------------------------------------------------------------
# Microsoft Clarity project ID. Tracking is completely disabled when blank,
# which is the correct setting for local and preview environments.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ---------------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------------
# Absolute origin, used for Stripe Checkout return URLs and the password-reset
# redirect. Optional on Vercel, which supplies VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
