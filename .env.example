# Stripe. Real keys never go in this file or in git — set them in Vercel's
# environment variables, and in .env.local for development.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Absolute origin used to build Checkout success and cancel URLs.
# Optional on Vercel, which supplies VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
