# Launch environment
#
# BCBA Prep now uses a dedicated Supabase project for member authentication.
# Only the publishable browser credentials belong in NEXT_PUBLIC_* variables.
# Never place a Supabase secret/service-role key in client-visible env vars.

# Stripe. Real secret keys never go in this file or in git — set them in
# Vercel's environment variables, and in .env.local for development.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase Auth. These are publishable browser values, not privileged secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Microsoft Clarity. Create the BCBA Prep site in Clarity, then copy its
# project ID here. Tracking stays completely disabled when this is blank.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Absolute origin used to build Checkout success/cancel URLs and future auth
# redirects. Optional on Vercel, which supplies VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
